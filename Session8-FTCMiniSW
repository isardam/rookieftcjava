package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;

/**
 * ============================================================
 * SESSION 8 - FTC MINI SOFTWARE CHALLENGE
 * ============================================================
 *
 * Mission:
 *
 *   1. Leave base
 *   2. Search for target
 *   3. Navigate around obstacle
 *   4. Deliver object
 *   5. Return home
 *
 * Java concepts:
 *
 *   - Variables
 *   - if / else
 *   - loops
 *   - methods
 *   - classes / objects
 *   - booleans
 *   - telemetry
 *   - FTC OpMode structure
 *   - debugging
 *
 * NOTE:
 * The movement methods are intentionally simple placeholders.
 * Students can later replace them with actual motor/encoder code.
 */
@Autonomous(name = "Session8_AutonomousMission", group = "Training")
public class Session8_AutonomousMission extends LinearOpMode {

    // =========================================================
    // ROBOT OBJECT
    // =========================================================

    private MissionRobot robot;

    // =========================================================
    // MISSION VARIABLES
    // =========================================================

    private boolean targetFound = false;
    private boolean objectCollected = false;
    private boolean obstacleDetected = false;
    private boolean missionComplete = false;

    private int searchAttempts = 0;
    private int maxSearchAttempts = 4;

    private int missionStep = 0;

    // =========================================================
    // FTC OP MODE
    // =========================================================

    @Override
    public void runOpMode() {

        // Create our Robot object
        robot = new MissionRobot();

        telemetry.addLine("================================");
        telemetry.addLine("  OPERATION HOMECOMING");
        telemetry.addLine("================================");
        telemetry.addLine("Initializing robot...");
        telemetry.update();

        // Initialize robot
        robot.initialize();

        telemetry.addLine("Robot initialized.");
        telemetry.addLine("Waiting for START...");
        telemetry.update();

        waitForStart();

        // Safety check
        if (isStopRequested()) {
            return;
        }

        telemetry.addLine("MISSION STARTED!");
        telemetry.update();

        // Run the autonomous mission
        runMission();

        // Final mission status
        if (missionComplete) {
            telemetry.addLine("--------------------------------");
            telemetry.addLine("MISSION SUCCESS!");
            telemetry.addLine("Robot returned home.");
            telemetry.addLine("--------------------------------");
        } else {
            telemetry.addLine("--------------------------------");
            telemetry.addLine("MISSION FAILED");
            telemetry.addLine("Review telemetry and debug.");
            telemetry.addLine("--------------------------------");
        }

        telemetry.update();

        // Keep telemetry visible
        sleep(3000);
    }

    // =========================================================
    // MAIN MISSION
    // =========================================================

    private void runMission() {

        // -----------------------------------------------------
        // STEP 1: LEAVE BASE
        // -----------------------------------------------------

        missionStep = 1;
        updateTelemetry("Leaving base...");

        leaveBase();

        if (isStopRequested()) {
            return;
        }

        // -----------------------------------------------------
        // STEP 2: FIND TARGET
        // -----------------------------------------------------

        missionStep = 2;
        updateTelemetry("Searching for target...");

        findTarget();

        if (isStopRequested()) {
            return;
        }

        // If target was not found, stop mission
        if (!targetFound) {

            telemetry.addLine("Target could not be found.");
            telemetry.addLine("Mission cannot continue.");
            telemetry.update();

            return;
        }

        // -----------------------------------------------------
        // STEP 3: NAVIGATE AROUND OBSTACLE
        // -----------------------------------------------------

        missionStep = 3;
        updateTelemetry("Navigating around obstacle...");

        navigateObstacle();

        if (isStopRequested()) {
            return;
        }

        // -----------------------------------------------------
        // STEP 4: COLLECT / DELIVER OBJECT
        // -----------------------------------------------------

        missionStep = 4;
        updateTelemetry("Collecting target...");

        collectObject();

        if (isStopRequested()) {
            return;
        }

        if (!objectCollected) {

            telemetry.addLine("Object was not collected.");
            telemetry.addLine("Mission cannot continue.");
            telemetry.update();

            return;
        }

        // -----------------------------------------------------
        // STEP 5: RETURN HOME
        // -----------------------------------------------------

        missionStep = 5;
        updateTelemetry("Returning home...");

        returnHome();

        if (isStopRequested()) {
            return;
        }

        // -----------------------------------------------------
        // STEP 6: COMPLETE
        // -----------------------------------------------------

        missionStep = 6;
        missionComplete = true;

        updateTelemetry("Mission complete!");
    }

    // =========================================================
    // MISSION PHASE 1
    // =========================================================

    private void leaveBase() {

        telemetry.addLine("BASE → MOVING");
        telemetry.update();

        robot.moveForward(24);

        telemetry.addLine("Base cleared.");
        telemetry.update();
    }

    // =========================================================
    // MISSION PHASE 2
    // =========================================================

    private void findTarget() {

        searchAttempts = 0;

        while (!targetFound && searchAttempts < maxSearchAttempts) {

            searchAttempts++;

            telemetry.addData(
                    "Search Attempt",
                    searchAttempts
            );

            telemetry.addLine("Scanning...");
            telemetry.update();

            // Move to next search location
            robot.moveForward(8);

            // Simulated sensor check
            targetFound = robot.detectTarget();

            if (targetFound) {

                telemetry.addLine("TARGET FOUND!");
                telemetry.update();

            } else {

                telemetry.addLine("Target not here.");
                telemetry.update();

                // Turn before trying again
                robot.turnRight(45);
            }

            sleep(500);
        }
    }

    // =========================================================
    // MISSION PHASE 3
    // =========================================================

    private void navigateObstacle() {

        obstacleDetected = robot.detectObstacle();

        if (obstacleDetected) {

            telemetry.addLine("Obstacle detected!");
            telemetry.addLine("Executing avoidance maneuver.");
            telemetry.update();

            // Turn right
            robot.turnRight(90);

            // Move around obstacle
            robot.moveForward(18);

            // Turn back toward target
            robot.turnLeft(90);

            telemetry.addLine("Obstacle cleared.");
            telemetry.update();

        } else {

            telemetry.addLine("Path clear.");
            telemetry.update();

            robot.moveForward(18);
        }
    }

    // =========================================================
    // MISSION PHASE 4
    // =========================================================

    private void collectObject() {

        telemetry.addLine("Approaching target...");
        telemetry.update();

        robot.moveForward(6);

        telemetry.addLine("Activating intake...");
        telemetry.update();

        robot.collect();

        objectCollected = robot.hasObject();

        if (objectCollected) {

            telemetry.addLine("Object collected!");

        } else {

            telemetry.addLine("Collection failed.");

        }

        telemetry.update();

        sleep(500);
    }

    // =========================================================
    // MISSION PHASE 5
    // =========================================================

    private void returnHome() {

        telemetry.addLine("Turning toward BASE...");
        telemetry.update();

        robot.turnLeft(180);

        telemetry.addLine("Traveling home...");
        telemetry.update();

        robot.moveForward(60);

        telemetry.addLine("BASE REACHED!");
        telemetry.update();
    }

    // =========================================================
    // TELEMETRY METHOD
    // =========================================================

    private void updateTelemetry(String status) {

        telemetry.addData("Mission Step", missionStep);
        telemetry.addData("Status", status);
        telemetry.addData("Target Found", targetFound);
        telemetry.addData("Object Collected", objectCollected);
        telemetry.addData("Obstacle Detected", obstacleDetected);
        telemetry.addData("Search Attempts", searchAttempts);
        telemetry.update();
    }

    // =========================================================
    // ROBOT CLASS
    // =========================================================

    /**
     * Robot object.
     *
     * In a real FTC program this class would contain:
     *
     *   - DcMotor objects
     *   - Servo objects
     *   - Sensors
     *   - Encoders
     *   - Movement methods
     */
    private class MissionRobot {

        private boolean holdingObject = false;

        // -----------------------------------------------------
        // INITIALIZATION
        // -----------------------------------------------------

        public void initialize() {

            telemetry.addLine("Robot hardware setup...");
            telemetry.update();

            /*
             * REAL FTC CODE WOULD GO HERE.
             *
             * Example:
             *
             * leftMotor = hardwareMap.get(
             *      DcMotor.class,
             *      "leftMotor"
             * );
             *
             * rightMotor = hardwareMap.get(
             *      DcMotor.class,
             *      "rightMotor"
             * );
             */
        }

        // -----------------------------------------------------
        // MOVEMENT
        // -----------------------------------------------------

        public void moveForward(int distance) {

            telemetry.addData(
                    "Robot Action",
                    "Move Forward %d units",
                    distance
            );

            telemetry.update();

            /*
             * Real FTC drivetrain code goes here.
             */

            sleep(300);
        }

        public void turnLeft(int degrees) {

            telemetry.addData(
                    "Robot Action",
                    "Turn Left %d degrees",
                    degrees
            );

            telemetry.update();

            /*
             * Real FTC drivetrain code goes here.
             */

            sleep(300);
        }

        public void turnRight(int degrees) {

            telemetry.addData(
                    "Robot Action",
                    "Turn Right %d degrees",
                    degrees
            );

            telemetry.update();

            /*
             * Real FTC drivetrain code goes here.
             */

            sleep(300);
        }

        // -----------------------------------------------------
        // SENSORS
        // -----------------------------------------------------

        public boolean detectTarget() {

            /*
             * Replace with a real sensor or camera.
             *
             * For this classroom challenge we return TRUE
             * after enough searching.
             */

            if (searchAttempts >= 2) {
                return true;
            }

            return false;
        }

        public boolean detectObstacle() {

            /*
             * Replace with distance sensor logic.
             *
             * Example:
             *
             * return distanceSensor.getDistance(
             *      DistanceUnit.CM
             * ) < 20;
             */

            return true;
        }

        // -----------------------------------------------------
        // COLLECTION
        // -----------------------------------------------------

        public void collect() {

            telemetry.addLine("Intake running...");
            telemetry.update();

            /*
             * Real intake motor/servo code goes here.
             */

            holdingObject = true;

            sleep(500);
        }

        public boolean hasObject() {

            return holdingObject;
        }
    }
}
